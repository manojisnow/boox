<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Boox"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

  <description>
    Boox backend PMD rules. maven-pmd-plugin has no top-level "exclude a rule from a
    category" config option (its excludeRules element is not a real parameter) - rule
    exclusion has to happen inside the ruleset that references the category, like this.
  </description>

  <rule ref="category/java/bestpractices.xml">
    <!-- Verified every site (ChatController, StreamController, JsonListCodec,
         OllamaChatEngine, ToolRegistry): all are standard SLF4J parameterized calls
         (LOGGER.info("...{}",  arg)), where argument evaluation is already cheap and
         deferred - the exact pattern that makes explicit level guards unnecessary. -->
    <exclude name="GuardLogStatement" />
  </rule>

  <rule ref="category/java/codestyle.xml">
    <!-- Checkstyle (google_checks.xml, UnusedImports) already enforces this. -->
    <exclude name="UnnecessaryImport" />
    <!-- Fights guard-clause early returns, which is how this codebase (and our
         nesting-depth conventions) validates input. -->
    <exclude name="OnlyOneReturn" />
    <!-- Default length thresholds flag idiomatic names like id/db/ok and legitimately
         descriptive ones; not worth tuning vs. just disabling. -->
    <exclude name="LongVariable" />
    <exclude name="ShortVariable" />
    <!-- Wants a comment justifying every package-private member; not a pattern this
         codebase uses intentionally. -->
    <exclude name="CommentDefaultAccessModifier" />
    <!-- Directly contradicts UnnecessaryConstructor for any class with no custom
         construction logic - no class can satisfy both. Keeping UnnecessaryConstructor
         (avoids dead code) and dropping this one instead. -->
    <exclude name="AtLeastOneConstructor" />
  </rule>

  <rule ref="category/java/design.xml">
    <!-- Flags plain-getter/setter classes as design smells, but our DTOs
         (ConversationSummary, SendMessageRequest, etc.) are plain classes by necessity:
         Checkstyle here can't parse Java records. -->
    <exclude name="DataClass" />
    <!-- Verified every site: all are deliberate resilience boundaries (Ollama HTTP
         calls, third-party Tool.execute(), SSE emitter completion) that must catch
         anything so one failure can't crash the request/stream. Narrowing them would
         defeat the boundary's purpose, not fix a bug. -->
    <exclude name="AvoidCatchingGenericException" />
    <!-- Requires explicit package/class config that was never provided - the rule
         doesn't run, it only emits a <configerror> ("No packages or classes
         specified") on every analysis. Not analyzing anything; safe to drop. -->
    <exclude name="LoosePackageCoupling" />
  </rule>

  <rule ref="category/java/errorprone.xml/AvoidDuplicateLiterals">
    <properties>
      <!-- "unchecked" in @SuppressWarnings("unchecked") repeats across every
           unchecked-cast site, but that value must be a literal - it's the
           standard Java idiom, not something to extract into a constant. -->
      <property name="skipAnnotations" value="true" />
    </properties>
  </rule>

  <rule ref="category/java/errorprone.xml">
    <exclude name="AvoidDuplicateLiterals" />
    <!-- Both flagged sites are SendMessageRequest's nullable defensive-copy getters
         (`return images == null ? null : List.copyOf(images);`). Returning null here
         is intentional - it's how ChatService distinguishes "field not present on this
         request" from "explicitly cleared" for the optional generation-config
         overrides; collapsing to an empty list would lose that distinction. -->
    <exclude name="NullAssignment" />
    <!-- Both sites are `int x = counter++;` and `while ((line = reader.readLine())
         != null)` - standard, well-understood Java idioms (the latter is the
         canonical JDK I/O read-loop pattern). Rewriting to avoid them adds lines
         without improving readability. -->
    <exclude name="AssignmentInOperand" />
  </rule>

  <rule ref="category/java/multithreading.xml">
    <!-- Verified every site: all are short-lived, method-local maps (request
         payload/options/schema builders) or a singleton's write-once-in-constructor,
         read-only-after map - never mutated concurrently. Not a thread-safety bug. -->
    <exclude name="UseConcurrentHashMap" />
  </rule>

  <rule ref="category/java/performance.xml">
    <!-- Both sites build one new Map per loop iteration to hold that iteration's own
         data (a per-tool-call message, a per-database-row context entry) - the
         allocation is not loop-invariant and can't be hoisted out. -->
    <exclude name="AvoidInstantiatingObjectsInLoops" />
  </rule>

  <rule ref="category/java/security.xml" />
</ruleset>
